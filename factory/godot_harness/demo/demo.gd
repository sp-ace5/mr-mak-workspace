extends Node3D
# Interactive showcase: pick a shader, drag its uniforms live. Runs in the editor and as the itch.io web demo.
# The scene (spheres + materials) is generated by build_demo.gd; this script only adds the UI.

const SPIN := 0.4
var targets: Array[MeshInstance3D] = []
var sliders: VBoxContainer
@onready var cam: Camera3D = $Camera

func _ready() -> void:
	for c in get_children():
		if c is MeshInstance3D and c.material_override is ShaderMaterial:
			targets.append(c)
	var layer := CanvasLayer.new()
	add_child(layer)
	var panel := PanelContainer.new()
	panel.position = Vector2(12, 12)
	panel.custom_minimum_size = Vector2(300, 0)
	layer.add_child(panel)
	var box := VBoxContainer.new()
	panel.add_child(box)
	var picker := OptionButton.new()
	for t in targets:
		picker.add_item(String(t.name).capitalize())
	picker.item_selected.connect(_select)
	box.add_child(picker)
	sliders = VBoxContainer.new()
	box.add_child(sliders)
	if not targets.is_empty():
		_select(0)

func _select(i: int) -> void:
	for c in sliders.get_children():
		c.queue_free()
	var mat := targets[i].material_override as ShaderMaterial
	for u in mat.shader.get_shader_uniform_list():
		var uname: String = u["name"]
		var value = mat.get_shader_parameter(uname)
		if value == null:
			value = RenderingServer.shader_get_parameter_default(mat.shader.get_rid(), uname)
		if u["hint"] == PROPERTY_HINT_RANGE:
			var r: PackedStringArray = String(u["hint_string"]).split(",")
			var label := Label.new()
			var s := HSlider.new()
			s.min_value = float(r[0])
			s.max_value = float(r[1])
			s.step = float(r[2]) if r.size() > 2 else 0.001
			s.value = value
			label.text = "%s  %.3f" % [uname, s.value]
			s.value_changed.connect(func(v: float) -> void:
				mat.set_shader_parameter(uname, v)
				label.text = "%s  %.3f" % [uname, v])
			sliders.add_child(label)
			sliders.add_child(s)
		elif u["type"] == TYPE_COLOR:
			var row := HBoxContainer.new()
			var l := Label.new()
			l.text = uname
			l.size_flags_horizontal = Control.SIZE_EXPAND_FILL
			var pick := ColorPickerButton.new()
			pick.color = value
			pick.custom_minimum_size = Vector2(60, 0)
			pick.color_changed.connect(func(c: Color) -> void: mat.set_shader_parameter(uname, c))
			row.add_child(l)
			row.add_child(pick)
			sliders.add_child(row)
	create_tween().tween_property(cam, "position", targets[i].position + Vector3(0, 0, 1.8), 0.5) \
		.set_trans(Tween.TRANS_SINE)

func _process(delta: float) -> void:
	for t in targets:
		t.rotate_y(SPIN * delta)
